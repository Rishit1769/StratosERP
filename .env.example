PORT=5000
NODE_ENV=development
SKIP_DB_PREPARE=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=StratosERP
DATABASE_URL="mysql://your_mysql_user:your_mysql_password@localhost:3306/StratosERP"

JWT_SECRET=replace_with_a_minimum_32_character_secret
JWT_EXPIRES_IN=24h

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_STUDY_MATERIALS=study-materials
MINIO_BUCKET_NOTICES=notices
MINIO_BUCKET_SUBMISSIONS=submissions

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

SEED_DEFAULT_PASSWORD=Password@123
